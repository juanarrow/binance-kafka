{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juanarrow.github.io/kafka-streaming-dashboard/reading.schema.json",
  "title": "Lectura",
  "description": "Mensaje del topic market.tickers. La clave Kafka es el campo series.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "series",
    "label",
    "observedAt",
    "value",
    "reference",
    "high",
    "low",
    "activity",
    "activityUnit"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "series": {
      "enum": ["BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT"]
    },
    "label": {
      "enum": ["BTC", "ETH", "SOL", "BNB"]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "reference": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "high": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "low": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "activity": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "activityUnit": {
      "const": "USDT"
    }
  }
}
